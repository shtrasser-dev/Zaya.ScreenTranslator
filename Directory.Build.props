<Project>
  <PropertyGroup>
    <ZayaPrimitivesVersion>2.0.0</ZayaPrimitivesVersion>
    <ZayaPrimitivesMajor>$([System.Version]::Parse('$(ZayaPrimitivesVersion)').Major)</ZayaPrimitivesMajor>

    <ZayaLoggingVersion>1.0.0</ZayaLoggingVersion>
    <ZayaOcrVersion>2.0.0</ZayaOcrVersion>
    <ZayaScreenshotVersion>2.0.0</ZayaScreenshotVersion>
    <ZayaTranslatorVersion>2.0.0</ZayaTranslatorVersion>
    <ZayaTranslatorCacheVersion>2.0.0</ZayaTranslatorCacheVersion>
    <ZayaPluginManagerVersion>1.0.0.0</ZayaPluginManagerVersion>
    <ZayaUIVersion>2.0.0.0</ZayaUIVersion>

    <!-- Host app default (Windows/Unix/Shared) when ZayaVersionRole is unset. -->
    <ZayaHostVersionMinor>0</ZayaHostVersionMinor>
    <ZayaHostVersionPatch>0</ZayaHostVersionPatch>
  </PropertyGroup>
</Project>

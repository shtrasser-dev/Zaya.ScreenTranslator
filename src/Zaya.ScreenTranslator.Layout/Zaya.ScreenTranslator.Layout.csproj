<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>

    <ZayaVersionRole>interface</ZayaVersionRole>
    <ZayaVersionInterface>2</ZayaVersionInterface>

    <PackageId>Zaya.ScreenTranslator.Layout</PackageId>
    <Title>Zaya Screen Translator — Overlay Layout Abstractions</Title>
    <Description>Overlay layout abstractions for Zaya Screen Translator (IOverlayLayoutService / session / OverlayItem).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>SHTrassEr</Authors>
    <RepositoryUrl>https://github.com/shtrasser-dev/Zaya.ScreenTranslator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Zaya.Logging" Version="$(ZayaLoggingVersion)" />
    <PackageReference Include="Zaya.Primitives" Version="$(ZayaPrimitivesVersion)" />
    <PackageReference Include="Zaya.OCR" Version="$(ZayaOcrVersion)" />
  </ItemGroup>

</Project>

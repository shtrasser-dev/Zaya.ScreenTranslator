<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.ViewModels"
        x:Class="Zaya.ScreenTranslator.Impl.Shared.Views.TextWindow"
        x:DataType="vm:TextWindowViewModel"
        Title="{Binding Loc[TextWindow_Title]}"
        Icon="/Assets/app.ico"
        Width="480" Height="320"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="{Binding IsTopmost}"
        Closing="OnClosing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0"
                 Text="{Binding RecognizedText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap" />
        <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
            <ToggleSwitch DockPanel.Dock="Right"
                          IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          VerticalAlignment="Center" />
            <TextBlock Text="{Binding Loc[TextWindow_Topmost]}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>

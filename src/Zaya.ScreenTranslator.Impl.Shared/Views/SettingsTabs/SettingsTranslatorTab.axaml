<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.ViewModels"
             xmlns:ctrl="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.Views.Controls"
             x:Class="Zaya.ScreenTranslator.Impl.Shared.Views.SettingsTabs.SettingsTranslatorTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="settings-column">
            <StackPanel>
                <TextBlock Classes="settings-intro"
                           Text="{Binding Loc[Settings_Desc_Translator]}" />
                <Border Classes="settings-divider" />

                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Loc[Settings_TranslatorEngine]}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1"
                              Classes="settings-control"
                              ItemsSource="{Binding AvailableTranslatorEngines}"
                              SelectedItem="{Binding SelectedTranslatorEngine, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}" />
                </Grid>
                <Border Classes="settings-divider" />
                <ctrl:SettingDescriptorListControl Name="TranslatorSettingsPanel"
                                                   ModuleKind="Translator" />

                <Border Classes="settings-divider" Margin="0,12,0,0" />
                <TextBlock Classes="settings-intro"
                           Text="{Binding Loc[Settings_Desc_TranslatorCache]}" />
                <Border Classes="settings-divider" />

                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Loc[Settings_TranslatorCacheEngine]}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1"
                              Classes="settings-control"
                              ItemsSource="{Binding AvailableTranslatorCacheEngines}"
                              SelectedItem="{Binding SelectedTranslatorCacheEngine, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Label}" />
                </Grid>
                <Border Classes="settings-divider" />
                <ctrl:SettingDescriptorListControl Name="TranslatorCacheSettingsPanel"
                                                   ModuleKind="Translator" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.ViewModels"
             xmlns:ctrl="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.Views.Controls"
             x:Class="Zaya.ScreenTranslator.Impl.Shared.Views.SettingsTabs.SettingsTextLayoutTab"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Name="TabScroll"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled">
        <Panel MinWidth="{Binding Viewport.Width, ElementName=TabScroll}">
            <Border Classes="settings-column">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,10">
                        <TextBlock Classes="settings-intro"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Loc[Settings_Desc_TextLayout]}" />
                        <ComboBox Grid.Column="1"
                                  Classes="settings-control"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailableTextLayoutEngines}"
                                  SelectedItem="{Binding SelectedTextLayoutEngine, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Id}" />
                    </Grid>
                    <Border Classes="settings-divider" />
                    <ctrl:SettingDescriptorListControl Name="TextLayoutSettingsPanel"
                                                       ModuleKind="TextLayout" />
                </StackPanel>
            </Border>
        </Panel>
    </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.ViewModels"
        xmlns:ctrl="clr-namespace:Zaya.ScreenTranslator.Impl.Shared.Views.Controls"
        x:Class="Zaya.ScreenTranslator.Impl.Shared.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Loc[Settings_Title]}"
        Width="920" Height="640"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <!-- Cursor-like settings row: label left, control right -->
        <Style Selector="Grid.settings-row">
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style Selector="Border.settings-column">
            <Setter Property="Width" Value="{x:Static ctrl:SettingControlFactory.SettingsColumnWidth}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="24,12" />
        </Style>
        <Style Selector="Border.settings-divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Opacity" Value="0.18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="ComboBox.settings-control">
            <Setter Property="Width" Value="{x:Static ctrl:SettingControlFactory.ControlWidth}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.settings-control">
            <Setter Property="Width" Value="{x:Static ctrl:SettingControlFactory.ControlWidth}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Profile selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Loc[Settings_ProfileName]}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ProfileNames}"
                      SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                      IsEditable="False"
                      MinWidth="160" />
        </StackPanel>

        <!-- Row 1: Tabs (strip on the left) -->
        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="MinWidth" Value="140" />
                    <Setter Property="Padding" Value="14,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Styles>

            <!-- Tab 1: General -->
            <TabItem Header="{Binding Loc[Settings_Tab_General]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_LangUI]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding UiLanguages}"
                                          SelectedItem="{Binding SelectedUiLanguage, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Name}" />
                            </Grid>
                            <Border Classes="settings-divider" />

                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_Theme]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="settings-divider" />

                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_TargetLang]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding TargetLanguages}"
                                          SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Name}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: OCR -->
            <TabItem Header="{Binding Loc[Settings_Tab_OCR]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_OcrEngine]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding AvailableOcrEngines}"
                                          SelectedItem="{Binding SelectedOcrEngine, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Id}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Name="OcrSettingsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Capture -->
            <TabItem Header="{Binding Loc[Settings_Tab_Capture]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_CaptureEngine]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding AvailableCaptureEngines}"
                                          SelectedItem="{Binding SelectedCaptureEngine, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Id}" />
                            </Grid>
                            <Border Classes="settings-divider" />

                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_TargetFps]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <TextBox Grid.Column="1"
                                         Classes="settings-control"
                                         Text="{Binding TargetFps, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="settings-divider" />

                            <StackPanel Name="CaptureSettingsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: TextLayout -->
            <TabItem Header="{Binding Loc[Settings_Tab_TextLayout]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_TextLayoutEngine]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding AvailableTextLayoutEngines}"
                                          SelectedItem="{Binding SelectedTextLayoutEngine, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Id}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Name="TextLayoutSettingsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: Translator -->
            <TabItem Header="{Binding Loc[Settings_Tab_Translator]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_TranslatorEngine]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding AvailableTranslatorEngines}"
                                          SelectedItem="{Binding SelectedTranslatorEngine, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Label}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Name="TranslatorSettingsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 6: Overlay -->
            <TabItem Header="{Binding Loc[Settings_Tab_Overlay]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel>
                            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Loc[Settings_OverlayEngine]}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1"
                                          Classes="settings-control"
                                          ItemsSource="{Binding AvailableOverlayLayoutEngines}"
                                          SelectedItem="{Binding SelectedOverlayLayoutEngine, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Label}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Name="OverlaySettingsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 7: Filter -->
            <TabItem Header="{Binding Loc[Settings_Tab_Filter]}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="settings-column">
                        <StackPanel Name="FilterSettingsPanel" />
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Row 2: Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding Loc[Settings_SaveAsNew]}"
                    Command="{Binding SaveAsNewCommand}" />
            <Button Content="{Binding Loc[Settings_Save]}"
                    Command="{Binding SaveCommand}" />
            <Button Content="{Binding Loc[Settings_Cancel]}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>

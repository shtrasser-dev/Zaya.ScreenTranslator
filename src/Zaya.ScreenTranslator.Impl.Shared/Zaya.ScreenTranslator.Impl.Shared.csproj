<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Title>Zaya Screen Translator</Title>
    <Description>Real-time on-screen text translator — shared UI and logic.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>SHTrassEr</Authors>
    <RepositoryUrl>https://github.com/shtrasser-dev/Zaya.ScreenTranslator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zaya.ScreenTranslator.Layout.Impl\Zaya.ScreenTranslator.Layout.Impl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Zaya.Primitives" Version="$(ZayaPrimitivesVersion)" />
    <PackageReference Include="Zaya.OCR" Version="$(ZayaOcrVersion)" />
    <PackageReference Include="Zaya.Screenshot" Version="$(ZayaScreenshotVersion)" />
    <PackageReference Include="Zaya.Translator" Version="$(ZayaTranslatorVersion)" />
    <PackageReference Include="Zaya.TranslatorCache" Version="$(ZayaTranslatorCacheVersion)" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Update\builtin-plugins.json" />
    <EmbeddedResource Include="Services\default-profile.json" />
    <EmbeddedResource Include="Services\manga-profile.json" />
  </ItemGroup>

</Project>

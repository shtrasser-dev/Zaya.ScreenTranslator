{
  "screenTranslator": {
    "profileName": "Manga",
    "translatorCache": "memory-translator-cache",
    "framePauseMs": 100,
    "targetProcess": "",
    "translator": "yandex",
    "captureRegions": [],
    "ignoreRegions": [],
    "ocr": "oneocr",
    "capture": "graphics-capture",
    "textLayout": "proximity-text-layout",
    "overlayLayout": "screen-overlay"
  },
  "screen-overlay": {
    "background": "opaque",
    "textColor": "dark",
    "fitMode": "wrap",
    "placement": "over",
    "backgroundColor": "light",
    "outline": false,
    "debugMode": false,
    "translateMode": "onDemand"
  },
  "oneocr": {
    "minConfidence": 40
  },
  "graphics-capture": {},
  "proximity-text-layout": {
    "wordGapThreshold": 70,
    "enableCenterAlignment": true,
    "lineSpacingThreshold": 160,
    "enableStabilization": true,
    "firstLineIndentTolerance": 0,
    "leftEdgeAlignmentTolerance": 200,
    "baselineDriftTolerance": 20,
    "holdNewBlocks": false,
    "paragraphFilters": [],
    "centerThresholdXPercent": 10,
    "centerThresholdYPercent": 10,
    "paragraphMergeHysteresisPercent": 120,
    "minLength": 1,
    "angleToleranceDegrees": 90,
    "sameLineWordGapHysteresisPercent": 200,
    "levenshteinThreshold": 10,
    "ghostMaxFrames": 0,
    "fontSizeTolerance": 100,
    "verticalColumns": true
  },
  "google": {
    "autoDetectLanguage": false
  },
  "memory-translator-cache": {},
  "yandex": {
    "autoDetectLanguage": true
  }
}
